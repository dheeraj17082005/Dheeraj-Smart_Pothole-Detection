# ==============================================================================
# Smart Pothole Detection and Reporting System - Environment Configuration
# ==============================================================================
# NOTE: The credentials below are default values for local assessment & evaluation.
# In production environments, replace with strong, securely managed secrets.
# ==============================================================================

# --- Database Settings (PostgreSQL 16 + PostGIS 3.4) ---
POSTGRES_DB=potholedb
POSTGRES_USER=pothole_user
POSTGRES_PASSWORD=pothole_password
POSTGRES_PORT=5432

# --- Object Storage Settings (MinIO) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminpassword
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_RAW_BUCKET=pothole-raw
MINIO_ANNOTATED_BUCKET=pothole-annotated

# --- AI Service Settings (FastAPI + ONNX YOLOv8) ---
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://ai-service:8000
AI_MODEL_PATH=/app/models/pothole_yolov8.onnx
AI_CONFIDENCE_THRESHOLD=0.25
AI_IOU_THRESHOLD=0.45
AI_IMAGE_SIZE=640

# --- Video Sampling & Processing ---
VIDEO_SAMPLE_FPS=2.0
VIDEO_MAX_DURATION_SECONDS=120

# --- Backend Settings (Spring Boot 3.2.3 / Java 21) ---
BACKEND_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/potholedb
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=200MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=200MB

# --- Frontend Settings (React 18 + Vite) ---
FRONTEND_PORT=80
VITE_API_BASE_URL=http://localhost:8080/api/v1
